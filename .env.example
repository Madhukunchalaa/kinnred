# Kinnred Environment Variables Configuration Template
# Copy this file to a new file named '.env' and fill in your credentials.

# Port to run the server on (Defaults to 4599)
PORT=4599

# MongoDB Atlas Connection URI
# Register and create a free database cluster at: https://www.mongodb.com/cloud/atlas
# Format: mongodb+srv://<username>:<password>@<cluster-address>/kinnred?retryWrites=true&w=majority
# MONGODB_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/?retryWrites=true&w=majority

# Secret password for the Admin Dashboard panel login (Defaults to 'admin123' if left blank)
ADMIN_PASSWORD=admin123
